# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin User IDs (comma separated)
ADMIN_IDS=8062873417

# Proxy settings (set USE_PROXY=false on foreign cloud servers)
PROXY_URL=http://127.0.0.1:10808
USE_PROXY=false

# Google Gemini AI Settings
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.7-flash
GEMINI_MODELS=gemini-3.7-flash,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
ALLOWED_MODELS=gemini-3.7-flash,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Database file path (On Railway attach Volume and set e.g. /data/bot.sqlite)
DB_PATH=./data/bot.sqlite

# Daily quota per user
DEFAULT_DAILY_QUOTA=24

# Web Search API Keys (Optional - Fallbacks to DDG Lite & Google News RSS automatically)
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
SEARXNG_URL=
